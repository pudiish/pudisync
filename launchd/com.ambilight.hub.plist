<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ambilight.hub</string>

  <!-- EDIT EVERY PATH: the python3 you installed the packages into, this repo,
       and your user folder. Keep the repo OUTSIDE Downloads, Documents and
       Desktop: macOS blocks background agents from reading those folders, and
       the agent would exit and restart in a loop. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>/Users/YOU/pudisync/ambilight.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/pudisync</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/ambilight.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/ambilight.log</string>

  <!-- If it does fail at start, wait 10s between attempts instead of spinning. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
