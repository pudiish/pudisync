<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ambilight.hub</string>

  <!-- EDIT BOTH PATHS: the python3 you installed the packages into, and this repo. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>/Users/YOU/pudisync/ambilight.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/pudisync</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/ambilight.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/ambilight.log</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
