{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pudsync.local/schemas/experience.schema.json",
  "title": "PudiSync Experience Configuration",
  "description": "Declarative style/scene configuration. Safety and transport settings are intentionally excluded.",
  "type": "object",
  "required": ["schema_version", "id", "name", "experience_type", "renderer", "parameters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 240},
    "experience_type": {"enum": ["monitor_style", "room_scene"]},
    "renderer": {"enum": ["monitor_natural", "monitor_vivid", "cinematic_1d", "trippy_1d", "pulse_1d", "neon_coast_1d", "aurora_1d", "deep_ocean_1d", "golden_hour_1d", "hearth_1d"]},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "motion_speed": {"type": "number", "minimum": 0, "maximum": 2},
        "colour_intensity": {"type": "number", "minimum": 0, "maximum": 1},
        "warp_strength": {"type": "number", "minimum": 0, "maximum": 1},
        "texture_amount": {"type": "number", "minimum": 0, "maximum": 1},
        "impact_amount": {"type": "number", "minimum": 0, "maximum": 1},
        "noise_scale": {"type": "number", "minimum": 0.01, "maximum": 10},
        "wave_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "brightness": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "palette": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["position", "hex"],
        "additionalProperties": false,
        "properties": {
          "position": {"type": "number", "minimum": 0, "maximum": 1},
          "hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      }
    },
    "audio_reactivity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": {"type": "boolean"},
        "default_level": {"enum": ["off", "subtle", "balanced", "expressive"]},
        "mappings": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["feature", "target", "depth", "attack_ms", "release_ms"],
            "additionalProperties": false,
            "properties": {
              "feature": {"enum": ["low_energy", "mid_energy", "high_energy", "sub_energy", "bass_envelope", "onset_strength", "kick_event", "snare_event", "stereo_pan"]},
              "target": {"enum": ["motion_speed", "warp_strength", "impact_amount", "texture_amount", "palette_phase", "brightness_modulation", "spot_spawn_rate"]},
              "depth": {"type": "number", "minimum": 0, "maximum": 0.5},
              "attack_ms": {"type": "integer", "minimum": 5, "maximum": 5000},
              "release_ms": {"type": "integer", "minimum": 20, "maximum": 10000},
              "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topology": {"enum": ["strip_1d", "matrix_2d", "multi_zone"]},
        "requires_monitor_frame": {"type": "boolean"}
      }
    }
  }
}
